# WeatherSense Backend — Environment Variables
# Copy this file to .env and fill in real values

# ── Firebase ──────────────────────────────────────────────────
FIREBASE_PROJECT_ID=your_firebase_project_id
# Path to the downloaded service account JSON file:
FIREBASE_SERVICE_ACCOUNT_KEY=./firebase-service-account.json
# OR inline JSON (for CI/CD):
# FIREBASE_CREDENTIALS_JSON={"type":"service_account",...}

FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com

# ── Google Gemini AI ──────────────────────────────────────────
GEMINI_API_KEY=your_google_ai_studio_api_key

# ── IMD (India Meteorological Department) ────────────────────
# Request access at: https://mausam.imd.gov.in/imd_latest/contents/api.php
MAUSAM_API_KEY=
MAUSAM_API_BASE_URL=https://api.weather.imd.gov.in/api
IMD_ENABLED=false

# ── Reddit API (optional) ─────────────────────────────────────
# Create app at: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=WeatherSense/1.0 by /u/your_reddit_username
REDDIT_ENABLED=false

# ── Meta (Facebook) Graph API (optional) ─────────────────────
META_ACCESS_TOKEN=
META_ENABLED=false

# ── Server ────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
